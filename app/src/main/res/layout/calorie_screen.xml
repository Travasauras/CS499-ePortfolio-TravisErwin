<?xml version="1.0" encoding="utf-8"?>
<!-- NestedScrollView (instead of ScrollView) so the calorie log's own scroll area inside it can scroll too -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:gravity="center"
            android:text="Calorie Tracker"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/todayTotalText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:textSize="20sp" />

        <LinearLayout
            android:orientation="horizontal"
            android:background="#DDDDDD"
            android:layout_width="match_parent"
            android:layout_height="60dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Date"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:background="#000000" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Calories"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:background="#000000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingHorizontal="12dp"
                android:gravity="center"
                android:text="Delete"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Calorie log: one row per calendar week, newest first. The open week also lists its entries.
             It has its own fixed-height scroll area so a long history doesn't push the inputs off screen. -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/calorieLogScroll"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:background="#FAFAFA"
            android:fadeScrollbars="false"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/calorieGridContainer"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:orientation="vertical"
            android:padding="6dp"
            android:background="#4CAF50"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/calorieDateInput"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="MM/DD/YYYY"
            android:inputType="date"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/calorieInput"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Calories"
            android:inputType="number"
            android:textSize="18sp" />

        <Button
            android:id="@+id/addCalorieButton"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#4CAF50"
            android:text="Add Calories"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />


        <!-- Returns to the main menu -->
        <Button
            android:id="@+id/mainMenuButton"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#757575"
            android:text="Main Menu"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
