<?xml version="1.0" encoding="utf-8"?>
<!-- Trends screen: pick a time interval and view a graph of weight over that period -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Screen title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:gravity="center"
            android:text="Trends"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Interval buttons, side by side. layout_weight="1" gives each an equal share of the width. -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/weekButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#4CAF50"
                android:text="Week"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/monthButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#4CAF50"
                android:text="Month"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/yearButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#4CAF50"
                android:text="Year"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Period navigation: step back to older weeks/months/years and forward again.
             Hidden until an interval is chosen. -->
        <LinearLayout
            android:id="@+id/periodNavigation"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/previousPeriodButton"
                android:layout_width="56dp"
                android:layout_height="50dp"
                android:backgroundTint="#757575"
                android:contentDescription="Previous period"
                android:text="◀"
                android:textColor="#FFFFFF" />

            <!-- Date range of the period being shown -->
            <TextView
                android:id="@+id/periodLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/nextPeriodButton"
                android:layout_width="56dp"
                android:layout_height="50dp"
                android:backgroundTint="#757575"
                android:contentDescription="Next period"
                android:text="▶"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- Weight graph (MPAndroidChart). Shows "No chart data available" until data is added. -->
        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/trendsChart"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="16dp" />

        <!-- Summary of the selected interval: average, weight change and trend,
             or "No weight data available" when there are no records -->
        <TextView
            android:id="@+id/trendSummaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="18sp" />

        <!-- Returns to the main menu -->
        <Button
            android:id="@+id/mainMenuButton"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#757575"
            android:text="Main Menu"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
