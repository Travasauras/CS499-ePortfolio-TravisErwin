<!-- Main menu: shown after login. Gives a quick summary and links to each part of the app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Screen title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:gravity="center"
        android:text="Weight Tracker 4000"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Today's summary. Left empty here because the Activity f -->
    <TextView
        android:id="@+id/todaySummaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:textSize="18sp" />

    <!-- Opens the weight tracker button -->
    <Button
        android:id="@+id/weightTrackerButton"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#4CAF50"
        android:text="Weight Tracker"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Calories Page button -->
    <Button
        android:id="@+id/calorieTrackerButton"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#4CAF50"
        android:text="Calorie Tracker"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Trends page button-->
    <Button
        android:id="@+id/trendsButton"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#4CAF50"
        android:text="Trends"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Logs out and returns to the login screen -->
    <Button
        android:id="@+id/logoutButton"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="#757575"
        android:text="Log Out"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

</LinearLayout>